{
    "name": "eryndrix/foundation",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.4",
        "doctrine/orm": "^3.6",
        "ramsey/uuid-doctrine": "^2.1",
        "symfony/cache": "^8.1",
        "symfony/mercure": "^0.8.0",
        "symfony/var-exporter": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Foundation\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev",
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
